# Puerto del servidor
PORT=3001

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:3000

# Conexión a PostgreSQL (no versionar el valor real)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/takeandgo?sslmode=verify-full"

# URL de Neon Auth (panel de Neon → Better Auth). Sin barra final.
NEON_AUTH_URL="https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth"