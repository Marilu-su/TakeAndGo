# Puerto del servidor
PORT=3001

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:3000

# Conexión a PostgreSQL (no versionar el valor real)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/takeandgo?sslmode=verify-full"

# URL de Neon Auth (panel de Neon → Better Auth). Sin barra final.
NEON_AUTH_URL="https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth"

# Pagos (MVP-06). "fake" simula el pago sin Mercado Pago (solo desarrollo).
PAYMENT_PROVIDER=fake

# Access Token de prueba de Mercado Pago (secreto: no versionar el valor real)
MERCADOPAGO_ACCESS_TOKEN="TEST-0000000000000000-000000-00000000000000000000000000000000-000000000"

# false: usa el checkout normal. Con credenciales de prueba, se paga iniciando
# sesión con la cuenta de prueba de comprador. El link "sandbox" falla al iniciar sesión.
MERCADOPAGO_SANDBOX=false

# URL de la web, para la vuelta del checkout. Sin barra final.
FRONTEND_URL=http://localhost:3000

# URL pública de la API, para los avisos de Mercado Pago. Vacía en local.
PUBLIC_API_URL=

# Clave secreta de los avisos (webhooks) de Mercado Pago, para validar su firma (secreto)
MERCADOPAGO_WEBHOOK_SECRET=
